# Generated by Chef for <%= node[:hostname] %>
# Record the rate at which the system clock gains/losses time.
log_level: "error"
redis_url: "redis.service:26379"
redis_password: "<%= @redis_password %>"
webui_url: "https://webui.service"
druid_url: "http://druid-broker.service:8082"
internal_api_token: "secret-token"
poll_interval_sec: 30
heartbeat_interval_sec: 5
worker_limit: 20
insecure_skip_verify: true
ingestion_stall_protection: true
missing_data_threshold_pct: 25.0
druid_recovery_cooldown_sec: 180

